#!/usr/bin/env sh

set -e

# Frontend: ESLint + Prettier on staged files via lint-staged
pnpm exec lint-staged

# Frontend: full TypeScript type check (cheap, catches cross-file issues)
pnpm exec tsc --noEmit

# Backend: rustfmt + clippy on the kapture crate ONLY. We use -p
# kapture (not --all) because the vendored kafka-protocol-rs fork at
# vendor/kafka-protocol-rs has its own rustfmt style we don't want to
# fight on every commit. Same for clippy: vendored crate is built
# with its own lints upstream.
cargo fmt --manifest-path src-tauri/Cargo.toml -p kapture -- --check
cargo clippy --manifest-path src-tauri/Cargo.toml -p kapture --all-targets --all-features -- -D warnings
