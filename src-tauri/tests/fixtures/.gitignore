# Maven build output
**/target/

# Eclipse / m2e IDE files (regenerated on import)
**/.classpath
**/.project
**/.settings/

# Generated self-signed test credentials — regenerated by certs/gen-certs.sh
# before each e2e run. Kept out of git so we don't ship fake creds.
certs/*.jks
certs/broker_*_creds
